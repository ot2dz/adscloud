# Meta Ads dashboard (HTTP engine, no browser) — environment variables

# Port the app listens on (Coolify maps the domain to it).
PORT=5002

# PostgreSQL (Coolify). Required in production; falls back to local SQLite if unset.
# Coolify gives you this as an internal connection string.
DATABASE_URL=postgresql://postgres:CHANGE_ME@metaads-db:5432/postgres

# Signs the session cookie. REQUIRED: the app refuses to start without a
# random value of 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (Local dev only: ALLOW_INSECURE_SECRET_KEY=1 uses a throwaway key.)
SECRET_KEY=

# Login sessions live in the database and expire after this many days.
# Logout revokes the session on the server; users can log out everywhere.
SESSION_DAYS=7
# Session cookie is HTTPS-only. Set to 0 only for plain-http local runs.
SESSION_COOKIE_SECURE=1

# Admin user seeded on first run. If ADMIN_PASSWORD is empty, no admin is
# created automatically.
ADMIN_EMAIL=must2dz@gmail.com
ADMIN_PASSWORD=

# Rotating proxy to avoid Meta IP blocks. Format: host:port:user:pass
# Comma-separated for a rotating pool.
META_ADS_PROXY=

# Pause between Meta requests (seconds) + random jitter. Raise if you get
# rate-limited (e.g. 1.0 / 0.5).
META_ADS_DELAY=0.3
META_ADS_JITTER=0.3

# Launch-date scrapes stop once this many ads in a row were launched before
# the chosen dates (the wanted ads are exhausted). 0 = always scan everything.
META_ADS_LAUNCH_EARLY_STOP=500

# Background count of each page's / store's total active ads (one request each,
# daily, only while no scrape runs). Set to off to disable it entirely.
ENTITY_STATS=on

# Shared secret for the ingest/worker APIs and legacy extension setups.
# Empty = those APIs are CLOSED (the extension then needs per-user login).
INGEST_TOKEN=

# Keep scraping in-process (no Playwright worker needed).
SCRAPE_ENABLED=true
