# Meta Ads dashboard (HTTP engine, no browser) — environment variables

# Port the app listens on (Coolify maps the domain to it).
PORT=5002

# PostgreSQL (Coolify). Required in production; falls back to local SQLite if unset.
# Coolify gives you this as an internal connection string.
DATABASE_URL=postgresql://postgres:CHANGE_ME@metaads-db:5432/postgres

# Flask session signing key. If unset, a random key is generated per process
# (sessions are dropped on restart).
SECRET_KEY=

# Admin user seeded on first run. If ADMIN_PASSWORD is empty, no admin is
# created automatically.
ADMIN_EMAIL=must2dz@gmail.com
ADMIN_PASSWORD=

# Rotating proxy to avoid Meta IP blocks. Format: host:port:user:pass
# Comma-separated for a rotating pool.
META_ADS_PROXY=

# Shared secret for the browser extension + ingest/worker APIs.
# Leave empty to run open (local development).
INGEST_TOKEN=

# Keep scraping in-process (no Playwright worker needed).
SCRAPE_ENABLED=true
